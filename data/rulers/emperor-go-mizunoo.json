{"id":"emperor-go-mizunoo","order":520,"name":"Emperor Go-Mizunoo","region":"east-asia","region_label":"East Asia","realm":"Emperor of Japan","era":"early-modern","era_label":"Early Modern","blurb":null,"reign_from":1611,"reign_to":1629,"year_from":1611,"year_to":1629,"wp":"Emperor Go-Mizunoo","source":"wikidata","civ_wiki":null,"sources":{"wikidata":"ok","wikipedia":"ok"},"qid":"Q320229","wikidata_url":"https://www.wikidata.org/wiki/Q320229","wd_label":"Emperor Go-Mizunoo","wd_description":"emperor of Japan from 1611 to 1629","birth_year":1596,"death_year":1680,"reign_wikidata":[1611,1629],"image":"https://commons.wikimedia.org/wiki/Special:FilePath/Emperor_Go-Mizunoo3.jpg?width=640","family_qid":"Q909452","predecessor_qid":null,"successor_qid":null,"father_qid":"Q349440","mother_qid":"Q6139376","children_qids":["Q120564","Q11446285","Q11514165","Q7142281","Q329765","Q11450087","Q10207028","Q434130","Q11499996","Q11388328","Q349414","Q10420536","Q10892241","Q10930627","Q11481356","Q313808","Q11668744","Q12144215","Q12144216","Q19801638","Q11458651","Q29841158","Q12144213"],"birthplace_qid":"Q34600","deathplace_qid":"Q34600","position_qids":["Q208233"],"family":"Imperial House of Japan","predecessor":null,"successor":null,"predecessor_id":null,"successor_id":null,"father":"Go-Yōzei","father_id":null,"mother":"Konoe Sakiko","children":["Empress Meishō","Onna Ni no miya","Akiko-naishinnō","Yoshiko-naishinnō","Go-Kōmyō","Shuchō-hosshinnō","Sōchō-joō","Kamo-no-miya","Bunchi-joō","Teruko-naishinnō","Go-Sai","Richū-joō","Yasuhito, Prince Hachijō","Gyōjo-hosshinnō","Tsuneko-naishinnō","Emperor Reigen","Sukehito-shinnō","Shōjō-hosshinnō","Bunsatsu-nyoō","Niinomiya","Sonkō-hosshinnō","Sonshō-hosshinnō","Seiin-hosshinnō"],"birthplace":"Kyoto","birthplace_coord":[135.76811,35.01161],"deathplace":"Kyoto","deathplace_coord":[135.76811,35.01161],"positions":["Emperor of Japan"],"extract":"Kotohito (Japanese: 政仁; IPA: [ko̞to̞çito̞]; 29 June 1596 – 11 September 1680, posthumously honored as Emperor Go-Mizunoo (後水尾天皇, Gomizunō Tennō; [ɡo̞mʲizɨno̞ː tẽ̞nːo̞ː]), was the 108th Emperor of Japan, according to the traditional order of succession. Go-Mizunoo's reign spanned the years from 1611 through 1629, and he was the first emperor to reign entirely during the Edo period.\nThis 17th-century sovereign was named after the 9th-century Emperor Seiwa, sometimes posthumously referred to as Mizunoo (水尾) because this is the location of his tomb, while go translates as \"later\", and thus, he could be called the \"Later Emperor Mizunoo\". The Japanese word go has also been translated to mean the \"second one\", and in some older sources, this emperor may be identified as \"Mizunoo, the second\" or \"Mizunoo II\".","wp_description":"Emperor of Japan from 1611 to 1629","wikipedia_url":"https://en.wikipedia.org/wiki/Emperor_Go-Mizunoo","image_lead":"https://upload.wikimedia.org/wikipedia/commons/f/f3/Emperor_Go-Mizunoo2.jpg","thumbnail":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f3/Emperor_Go-Mizunoo2.jpg/960px-Emperor_Go-Mizunoo2.jpg","chat_ready":true,"display_from":1611,"display_to":1629}